# Copy to .env and adjust. Never commit .env.
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Where the customer-facing frontend lives; used to build magic links.
PUBLIC_BASE_URL=
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=
# Set to true on your own machine to open Swagger at /docs. Leave unset in production.
ENABLE_DOCS=